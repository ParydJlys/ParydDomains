<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Assistant - Teacher AI</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Outfit:wght@600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { 
            --bg-main: #0f1115; 
            --bg-sidebar: #16191f; 
            --accent: #6366f1; 
            --glass: rgba(255, 255, 255, 0.03);
        }
        body { background-color: var(--bg-main); color: #f1f5f9; font-family: 'Plus Jakarta Sans', sans-serif; }
        h1, h2, h3, .font-title { font-family: 'Outfit', sans-serif; }
        
        .sidebar { 
            background-color: var(--bg-sidebar); 
            width: 280px; 
            position: fixed; 
            left: 0; top: 0; bottom: 0; 
            z-index: 100;
            border-right: 1px solid rgba(255,255,255,0.05);
            transform: translateX(-100%);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); 
        }
        .sidebar.active { transform: translateX(0); }
        
        .sidebar-overlay { 
            display: none; position: fixed; inset: 0; 
            background: rgba(0,0,0,0.8); z-index: 90; backdrop-filter: blur(8px);
        }
        .sidebar-overlay.active { display: block; }

        #mainContent { transition: all 0.4s ease; width: 100%; }

        @media (min-width: 1024px) {
            .sidebar { transform: translateX(0); position: fixed; }
            #mainContent { margin-left: 280px; width: calc(100% - 280px); }
            .sidebar.hidden-sidebar { transform: translateX(-100%); }
            #mainContent.full-width { margin-left: 0; width: 100%; }
        }

        /* LOGIN AREA & AVATAR FIX */
        .login-container {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 6px 14px;
            background: rgba(255, 255, 255, 0.02);
            border: 1.5px solid rgba(99, 102, 241, 0.2); 
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .avatar-wrapper {
            position: relative;
            width: 40px; height: 40px;
            min-width: 40px; min-height: 40px;
            border-radius: 12px;
            border: 2px solid var(--accent);
            overflow: hidden;
            background: #1c1f26;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 0 10px rgba(99, 102, 241, 0.3);
        }

        #userAvatar { width: 100%; height: 100%; object-fit: cover; display: none; }
        #defaultAvatarIcon { font-size: 1.1rem; color: var(--accent); }
        #googleBtnWrapper { position: absolute; opacity: 0.01; width: 100%; height: 100%; z-index: 10; cursor: pointer; }

        /* INPUT & CHAT */
        .input-wrapper {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 28px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            transition: all 0.3s;
        }
        .input-wrapper:focus-within { border-color: var(--accent); }
        
        /* MODAL STYLES */
        .modal-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.85); backdrop-filter: blur(12px);
            z-index: 200; align-items: center; justify-content: center;
        }
        .modal-content {
            background: #16191f; border: 1px solid rgba(255,255,255,0.08);
            padding: 2rem; border-radius: 32px; max-width: 500px; width: 92%;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .text-gradient { background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .user-msg { background: var(--accent); padding: 14px 20px; border-radius: 22px 22px 4px 22px; align-self: flex-end; max-width: 80%; color: white; }
        .ai-msg { background: var(--glass); padding: 16px 22px; border-radius: 4px 22px 22px 22px; align-self: flex-start; max-width: 85%; border: 1px solid rgba(255,255,255,0.05); }
        
        /* TYPING ANIMATION */
        .typing-dot { width: 6px; height: 6px; background: #818cf8; border-radius: 50%; display: inline-block; animation: typing 1s infinite ease-in-out; }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; margin: 0 4px; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typing { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }

        /* STATUS ONLINE */
        .status-online { width: 8px; height: 8px; background: #10b981; border-radius: 50%; display: inline-block; margin-left: 6px; box-shadow: 0 0 8px #10b981; }

        .custom-scroll::-webkit-scrollbar { width: 5px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
        .mic-active { color: #ef4444 !important; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <div id="sidebarOverlay" class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <aside id="sidebar" class="sidebar flex flex-col p-4 active">
        <div class="flex justify-between items-center mb-8 px-2">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
                    <i class="fa-solid fa-bolt text-white text-sm"></i>
                </div>
                <div class="flex items-center">
                    <span class="font-bold tracking-tight text-lg">Guru AI</span>
                    <span class="status-online"></span>
                </div>
            </div>
            <i class="fa-solid fa-xmark lg:hidden text-gray-500 cursor-pointer" onclick="toggleSidebar()"></i>
        </div>

        <button onclick="newChat()" class="flex items-center justify-center gap-2 p-3.5 mb-8 bg-white/5 hover:bg-white/10 rounded-2xl w-full text-white font-medium transition-all border border-white/5">
            <i class="fa-solid fa-plus text-xs"></i> Chat Baru
        </button>

        <div class="mb-8">
            <p class="px-2 text-[11px] font-bold text-indigo-400 uppercase tracking-widest mb-4">Pintasan</p>
            <div class="space-y-2">
                <div onclick="sendShortcut('Buatkan bank soal Matematika SD kelas 6')" class="flex items-center p-3 rounded-xl cursor-pointer text-gray-400 hover:bg-white/5 hover:text-white transition">
                    <i class="fa-solid fa-book-open mr-3 text-sm"></i> Tamplate Bank Soal SD
                </div>
                <div onclick="sendShortcut('Buatkan bank soal IPA SMP kelas 9')" class="flex items-center p-3 rounded-xl cursor-pointer text-gray-400 hover:bg-white/5 hover:text-white transition">
                    <i class="fa-solid fa-graduation-cap mr-3 text-sm"></i> Tamplate Bank Soal SMP
                </div>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto custom-scroll pr-2">
            <p class="px-2 text-[11px] font-bold text-gray-500 uppercase tracking-widest mb-4">Riwayat Chat</p>
            <div id="chatHistory" class="space-y-1">
                </div>
        </div>

        <div class="mt-auto pt-6 border-t border-white/5">
            <div onclick="toggleModal()" class="flex items-center px-4 py-3 rounded-xl cursor-pointer text-gray-400 hover:bg-white/5 hover:text-white transition-all group mb-4">
                <i class="fa-solid fa-circle-info mr-3 text-indigo-500"></i>
                <span class="text-sm font-medium">Informasi & Setelan</span>
            </div>
            <div class="p-3 bg-indigo-500/5 rounded-xl border border-indigo-500/10 text-center">
                <p class="text-[10px] text-gray-500 mb-1">Developed by</p>
                <p class="text-xs font-bold text-indigo-400">Ahmad Farid Ridho</p>
            </div>
        </div>
    </aside>

    <div id="mainContent" class="flex flex-col relative overflow-hidden">
        <header class="p-5 flex justify-between items-center z-[50] relative">
            <div class="flex items-center gap-4">
                <button id="menuBtnMain" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 hover:bg-white/10 lg:hidden" onclick="toggleSidebar()">
                    <i class="fa-solid fa-bars-staggered text-gray-400"></i>
                </button>
            </div>
            
            <div class="login-container">
                <div class="text-right hidden sm:flex flex-col justify-center">
                    <p class="text-[10px] text-gray-500 leading-none mb-1 font-bold uppercase">Aktif Sebagai</p>
                    <p id="userNameDisplay" class="text-xs font-bold text-white leading-none tracking-tight mb-1">Guest User</p>
                    <button id="logoutBtn" onclick="googleLogout()" class="hidden text-[9px] text-red-400 font-bold hover:text-red-300 transition text-right uppercase tracking-tighter">
                        <i class="fa-solid fa-right-from-bracket mr-1"></i>Logout
                    </button>
                </div>
                <div class="avatar-wrapper">
                    <div id="googleBtnWrapper"></div>
                    <i id="defaultAvatarIcon" class="fa-solid fa-user-tie"></i>
                    <img id="userAvatar" src="" alt="User">
                </div>
            </div>
        </header>

        <main class="flex-1 flex flex-col items-center overflow-hidden px-4">
            <div id="welcome-screen" class="w-full max-w-3xl flex-1 flex flex-col justify-center items-center text-center">
                <div class="w-20 h-20 bg-indigo-600/20 rounded-3xl flex items-center justify-center mb-8 animate-bounce">
                    <i class="fa-solid fa-brain text-4xl text-indigo-500"></i>
                </div>
                <h2 id="welcomeName" class="text-xl text-gray-400 font-medium mb-2"></h2>
                <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight leading-tight mb-6 font-title">Bagaimana saya bisa membantu anda? <span class="text-gradient">untuk</span> sekarang?</h1>
                <p class="text-gray-500 max-w-md">Asisten cerdas berbasis AI untuk mempermudah pekerjaan guru dalam menyusun soal dan materi.</p>
            </div>
            
            <div id="chatContainer" class="w-full max-w-3xl flex-1 overflow-y-auto py-8 hidden flex flex-col space-y-8 custom-scroll"></div>

            <div class="w-full max-w-3xl pb-8 pt-4 relative">
                <div class="input-wrapper p-2 shadow-2xl transition-all">
                    <div class="flex items-end gap-2 px-2">
                        <textarea id="userInput" placeholder="Tanyakan apa saja..." 
                            class="flex-1 bg-transparent border-none focus:outline-none resize-none text-white py-3 px-2 min-h-[50px] max-h-40" 
                            onkeypress="handleKeyPress(event)"></textarea>
                        
                        <div class="flex gap-2 pb-2">
                            <button id="micBtn" class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/5 text-gray-400 transition" onclick="toggleSpeech()">
                                <i class="fa-solid fa-microphone text-lg"></i>
                            </button>
                            <button id="sendBtn" class="w-10 h-10 flex items-center justify-center rounded-full bg-indigo-600 hover:bg-indigo-500 text-white transition-all active:scale-95" onclick="sendMessage()">
                                <i class="fa-solid fa-paper-plane text-sm"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="flex justify-between items-center px-4 mt-4">
                    <p class="text-[10px] text-gray-600 uppercase tracking-widest font-bold">Powered by Ahmad Farid Ridho</p>
                    <p class="text-[10px] text-gray-500 italic">Dev: Ahmad Farid Ridho</p>
                </div>
            </div>
        </main>
    </div>

    <div id="aiModal" class="modal-overlay" onclick="toggleModal()">
        <div class="modal-content" onclick="event.stopPropagation()">
            <div class="flex justify-between items-center mb-8">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/20">
                        <i class="fa-solid fa-robot text-white"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold font-title text-white leading-none">Guru AI <span class="text-indigo-400 text-sm ml-1">v1.5</span></h3>
                        <p class="text-[10px] text-gray-500 uppercase tracking-widest font-bold mt-1">Official Assistant</p>
                    </div>
                </div>
                <button onclick="toggleModal()" class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 hover:bg-red-500/20 hover:text-red-400 text-gray-500 transition-all">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="space-y-6">
                <div class="p-4 bg-white/5 rounded-2xl border border-white/5">
                    <p class="text-xs text-gray-400 leading-relaxed">
                        Guru AI adalah asisten virtual cerdas yang dirancang khusus untuk mendukung produktivitas tenaga pengidik di era digital.
                    </p>
                </div>

                <div>
                    <h4 class="text-[10px] font-bold text-indigo-400 uppercase tracking-[0.2em] mb-3 px-1">Tujuan Pengembangan</h4>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="p-3 bg-white/5 rounded-xl border border-white/5">
                            <i class="fa-solid fa-bolt-lightning text-amber-400 text-xs mb-2"></i>
                            <p class="text-[10px] font-bold text-white mb-0.5">Efisiensi Waktu</p>
                            <p class="text-[9px] text-gray-500">Mempercepat pembuatan soal & materi.</p>
                        </div>
                        <div class="p-3 bg-white/5 rounded-xl border border-white/5">
                            <i class="fa-solid fa-wand-magic-sparkles text-purple-400 text-xs mb-2"></i>
                            <p class="text-[10px] font-bold text-white mb-0.5">Inovasi Guru</p>
                            <p class="text-[9px] text-gray-500">Membantu ide kreatif mengajar.</p>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                    <div>
                        <p class="text-[9px] text-gray-600 uppercase font-bold">Created By</p>
                        <p class="text-sm font-bold text-indigo-400">Ahmad Farid Ridho</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="https://www.tiktok.com/@cleopryd?_r=1&_t=ZS-96FMBt0mXwN" target="_blank" class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-gray-400 hover:text-white transition">
                            <i class="fa-brands fa-tiktok text-sm"></i>
                        </a>
                        <a href="https://www.instagram.com/parydrido?igsh=aGx1cHVlZmI3c25k" target="_blank" class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-gray-400 hover:text-white transition">
                            <i class="fa-brands fa-instagram text-sm"></i>
                        </a>
                    </div>
                </div>
            </div>

            <button onclick="toggleModal()" class="w-full mt-8 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-2xl font-bold text-sm shadow-lg shadow-indigo-600/20 transition-all active:scale-[0.98]">
                Selesai
            </button>
        </div>
    </div>

    <script>
        const GROQ_API_KEY = "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";
        const GOOGLE_CLIENT_ID = "286833777579-obuimabinn4f22cse7hgjh4i7jg73m3o.apps.googleusercontent.com"; 
        let recognition;
        let chatsHistory = JSON.parse(localStorage.getItem('guru_ai_chats')) || [];
        
        window.onload = function () {
            if (GOOGLE_CLIENT_ID) {
                google.accounts.id.initialize({ client_id: GOOGLE_CLIENT_ID, callback: handleCredentialResponse });
                google.accounts.id.renderButton(document.getElementById("googleBtnWrapper"), { type: "icon", shape: "circle", theme: "outline", size: "large" });
            }
            renderHistory();
        };

        function handleCredentialResponse(response) {
            const responsePayload = decodeJwtResponse(response.credential);
            document.getElementById('userNameDisplay').innerText = responsePayload.name;
            document.getElementById('welcomeName').innerText = "Halo, " + responsePayload.given_name;
            document.getElementById('googleBtnWrapper').style.display = 'none';
            document.getElementById('defaultAvatarIcon').style.display = 'none';
            document.getElementById('logoutBtn').classList.remove('hidden');
            const userImg = document.getElementById('userAvatar');
            userImg.src = responsePayload.picture;
            userImg.style.display = 'block';
        }

        function decodeJwtResponse(token) {
            let base64 = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
            return JSON.parse(decodeURIComponent(window.atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')));
        }

        function googleLogout() {
            google.accounts.id.disableAutoSelect();
            location.reload();
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            if (window.innerWidth < 1024) { sidebar.classList.toggle('active'); overlay.classList.toggle('active'); }
            else { sidebar.classList.toggle('hidden-sidebar'); document.getElementById('mainContent').classList.toggle('full-width'); }
        }

        function toggleModal() {
            const modal = document.getElementById('aiModal');
            modal.style.display = (modal.style.display === 'flex') ? 'none' : 'flex';
        }

        function toggleSpeech() {
            if (!('webkitSpeechRecognition' in window)) return alert("Browser tidak mendukung Speech Recognition.");
            if (!recognition) {
                recognition = new webkitSpeechRecognition();
                recognition.lang = 'id-ID';
                recognition.onstart = () => document.getElementById('micBtn').classList.add('mic-active');
                recognition.onend = () => document.getElementById('micBtn').classList.remove('mic-active');
                recognition.onresult = (e) => { document.getElementById('userInput').value = e.results[0][0].transcript; sendMessage(); };
            }
            recognition.start();
        }

        function handleKeyPress(e) { if(e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } }

        function sendShortcut(text) {
            const input = document.getElementById('userInput');
            input.value = text;
            input.focus();
        }

        function renderHistory() {
            const container = document.getElementById('chatHistory');
            container.innerHTML = "";
            chatsHistory.forEach((chat, index) => {
                const div = document.createElement('div');
                div.className = "flex items-center justify-between group p-3 rounded-xl cursor-pointer text-gray-400 hover:bg-white/5 hover:text-white transition";
                div.innerHTML = `
                    <div class="flex items-center overflow-hidden flex-1" onclick="loadChat(${index})">
                        <i class="fa-regular fa-message mr-3 text-xs"></i>
                        <span class="text-xs truncate font-medium">${chat.title}</span>
                    </div>
                    <i class="fa-solid fa-trash-can text-[10px] text-gray-600 hover:text-red-500 ml-2 opacity-0 group-hover:opacity-100 transition" onclick="deleteChat(${index})"></i>
                `;
                container.appendChild(div);
            });
        }

        function saveToHistory(text) {
            const title = text.length > 25 ? text.substring(0, 25) + "..." : text;
            chatsHistory.unshift({ title: title, content: document.getElementById('chatContainer').innerHTML });
            if (chatsHistory.length > 20) chatsHistory.pop();
            localStorage.setItem('guru_ai_chats', JSON.stringify(chatsHistory));
            renderHistory();
        }

        function loadChat(index) {
            const welcomeScreen = document.getElementById('welcome-screen');
            const chatContainer = document.getElementById('chatContainer');
            welcomeScreen.classList.add('hidden');
            chatContainer.classList.remove('hidden');
            chatContainer.innerHTML = chatsHistory[index].content;
            if (window.innerWidth < 1024) toggleSidebar();
        }

        function deleteChat(index) {
            chatsHistory.splice(index, 1);
            localStorage.setItem('guru_ai_chats', JSON.stringify(chatsHistory));
            renderHistory();
        }

        function newChat() {
            const container = document.getElementById('chatContainer');
            if (container.children.length > 0) {
                const firstMsg = container.querySelector('.user-msg').innerText;
                saveToHistory(firstMsg);
            }
            container.innerHTML = "";
            container.classList.add('hidden');
            document.getElementById('welcome-screen').classList.remove('hidden');
        }

        async function sendMessage() {
            const input = document.getElementById('userInput');
            const chatContainer = document.getElementById('chatContainer');
            const welcomeScreen = document.getElementById('welcome-screen');
            const userText = input.value.trim();
            if (!userText) return;

            welcomeScreen.classList.add('hidden');
            chatContainer.classList.remove('hidden');
            
            const userDiv = document.createElement('div');
            userDiv.className = 'user-msg';
            userDiv.innerText = userText;
            chatContainer.appendChild(userDiv);
            input.value = "";
            chatContainer.scrollTop = chatContainer.scrollHeight;

            const aiDiv = document.createElement('div');
            aiDiv.className = 'ai-msg';
            aiDiv.innerHTML = `
                <div class="flex items-center gap-1">
                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>
                </div>`;
            chatContainer.appendChild(aiDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;

            try {
                const response = await fetch("https://api.groq.com/openai/v1/chat/completions", {
                    method: "POST",
                    headers: { "Authorization": `Bearer ${GROQ_API_KEY}`, "Content-Type": "application/json" },
                    body: JSON.stringify({
                        messages: [{ role: "system", content: "Kamu adalah Guru AI yang cerdas membantu guru menyusun soal dan materi pendidikan." }, { role: "user", content: userText }],
                        model: "llama-3.3-70b-versatile"
                    })
                });
                const data = await response.json();
                let content = data.choices[0].message.content.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
                aiDiv.innerHTML = content;
            } catch (error) { 
                aiDiv.innerHTML = "Maaf, terjadi kesalahan teknis."; 
            }
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }
    </script>
</body>
</html>
